FROM node:22-alpine

WORKDIR /app

# Enable Corepack so the Yarn version pinned for the project (Yarn 4) is available
RUN corepack enable

# Copy the package manager files first so the dependency layer stays cached
# until they change
COPY package.json yarn.lock ./
COPY .yarnrc.yml ./

# Install exact versions from the lockfile and fail if it is out of date
RUN yarn install --immutable

# Copy the application source after installing dependencies to preserve the cache
COPY . .

# Document the port the server listens on
EXPOSE 3000

CMD ["yarn", "start"]
