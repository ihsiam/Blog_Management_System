{
  "root": true,
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 12
  },
  "extends": ["airbnb-base", "prettier"],
  "rules": {
    /* =====================
       Code Quality Rules
       ===================== */

    "no-console": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-underscore-dangle": "off",
    "no-return-await": "off",

    /* =====================
       Formatting Rules
       (delegated to Prettier)
       ===================== */

    "indent": "off",
    "comma-dangle": "off",
    "object-curly-newline": "off",
    "implicit-arrow-linebreak": "off",
    "linebreak-style": "off"
  },
  "overrides": [
    {
      /* =====================
         Test files
         ===================== */
      "files": [
        "test/**/*.js",
        "**/*.test.js",
        "**/*.spec.js",
        "jest.integration.config.js"
      ],
      "env": {
        "jest": true
      },
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          { "devDependencies": true }
        ],
        "global-require": "off",
        "import/no-dynamic-require": "off",
        "no-await-in-loop": "off",
        "no-promise-executor-return": "off",
        "func-names": "off"
      }
    }
  ]
}
